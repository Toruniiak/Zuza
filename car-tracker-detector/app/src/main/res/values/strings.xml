    <!-- Permissions -->
    <string name="permissions_title">Wymagane uprawnienia</string>
    <string name="permissions_explanation_scan_legacy">Na tej wersji Androida skanowanie Bluetooth wymaga
        uprawnienia lokalizacji (ACCESS_FINE_LOCATION). To wymóg systemu Android, nie tej aplikacji — Android
        traktuje wyniki skanu BLE jako potencjalnie ujawniające lokalizację. Aplikacja NIE zapisuje ani nie
        wysyła Twojej lokalizacji GPS.</string>
    <string name="permissions_explanation_scan_modern">Aplikacja prosi wyłącznie o uprawnienie \"Urządzenia w
        pobliżu\" (BLUETOOTH_SCAN), oznaczone jako niezwiązane z lokalizacją. Nie prosimy o dostęp do
        lokalizacji, ponieważ nie jest nam potrzebny.</string>
    <string name="permissions_grant_button">Nadaj uprawnienia</string>
    <string name="permissions_denied_message">Bez tego uprawnienia Android nie pozwala na skanowanie
        Bluetooth Low Energy — to ograniczenie systemu.</string>
    <string name="permissions_open_settings">Otwórz ustawienia aplikacji</string>

