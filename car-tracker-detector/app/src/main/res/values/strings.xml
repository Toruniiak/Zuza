    <!-- Full scan procedure -->
    <string name="procedure_title">Procedura pełnego skanowania</string>
    <string name="procedure_step_1">1. Zaparkuj samochód.</string>
    <string name="procedure_step_2">2. Wyłącz silnik.</string>
    <string name="procedure_step_3">3. Zamknij drzwi.</string>
    <string name="procedure_step_4">4. Jeśli to możliwe, wyłącz Bluetooth w swoich własnych urządzeniach.</string>
    <string name="procedure_step_5">5. Rozpocznij skanowanie.</string>
    <string name="procedure_step_6">6. Przejdź wokół samochodu.</string>
    <string name="procedure_step_7">7. Wejdź do środka.</string>
    <string name="procedure_step_8">8. Sprawdź urządzenia wykrywane wielokrotnie.</string>
    <string name="procedure_step_9">9. Zbliż się do podejrzanego sygnału (\"Znajdź źródło sygnału\").</string>
    <string name="procedure_step_10">10. Sprawdź fizycznie samochód (\"Gdzie szukać?\").</string>
    <string name="procedure_start">Rozumiem, zaczynamy</string>
