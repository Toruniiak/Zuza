<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose zarządza tematem samodzielnie (ui/theme/Theme.kt). Ten wpis to jedynie
         motyw "bootstrap" dla systemowego splash/okna, zanim Compose przejmie kontrolę. -->
    <style name="Theme.CarTrackerDetector" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
